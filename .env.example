# App
NODE_ENV=development
PORT=4173
APP_BASE_URL=http://localhost:4173

# Default tracking settings
DEFAULT_TICKERS=SPCE,SPCX
DEFAULT_LOOKBACK_HOURS=24
CACHE_TTL_SECONDS=45
REQUEST_TIMEOUT_MS=9000

# Reddit public JSON endpoints
# Without credentials, the app tries public JSON endpoints. If Reddit blocks those
# from your network, configure OAuth credentials or a bearer token below.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_BEARER_TOKEN=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_DEVICE_ID=stockhypetrackerlocal01
REDDIT_USER_AGENT=stock-hype-tracker/0.1.0 by u_your_username
# Keep requests modest and use only communities you are allowed to access.
REDDIT_SUBREDDITS=wallstreetbets,stocks,pennystocks,Shortsqueeze,SPACs,investing,options
REDDIT_POST_LIMIT=100
MAX_COMMENT_POSTS=7

# Optional
LOG_LEVEL=info
